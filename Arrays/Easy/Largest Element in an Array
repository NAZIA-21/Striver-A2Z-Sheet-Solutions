//Approach 1:
//TC: O(n)
//SC: O(1)
class Solution {
    public int largestElement(int[] nums) {
        int largest = nums[0];
        int n = nums.length;

        for(int i= 1; i< n; i++){
            if(nums[i] > largest){
                largest = nums[i];
            }
        }
    return largest;
    }
}

//Approach 2:
//TC: O(n)
//SC: O(1)
class Solution {
    public static int largest(int[] arr) {
        int largest = Integer.MIN_VALUE;
        for(int i=0 ; i < arr.length-1 ; i++){
            if(arr[i] > arr[i+1]){
                largest = Math.max(largest , arr[i]);
            } else{
                largest = Math.max(largest , arr[i +1]);
            }
        }
        return largest;
    }
}

